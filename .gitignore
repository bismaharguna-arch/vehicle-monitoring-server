# ================================================================
#  .gitignore — Vehicle Monitoring Server
#  Prinsip: source code masuk git, lingkungan & data runtime TIDAK.
# ================================================================

# --- Virtual environment (WAJIB, ~300 MB, tidak portable) ---
venv/
.venv/
env/

# --- Rahasia & konfigurasi lokal (JANGAN pernah ke-push) ---
.env
.env.*
!.env.example
*.key
api_key.txt

# --- Python cache / build ---
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.eggs/
build/
dist/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# --- Data runtime (dibuat saat server jalan, bukan source) ---
uploads/
*.log

# --- Database lokal (kalau ada; proyek utama pakai MySQL eksternal) ---
*.sqlite
*.sqlite3
*.db

# --- File OS / editor ---
Thumbs.db
desktop.ini
.DS_Store
.vscode/
.idea/

# --- Setelan & scaffolding Claude Code (khusus mesin ini) ---
.claude/

# --- Scaffolding Claude Code / skills (bukan bagian proyek) ---
.agents/
/SKILL.md
skills-lock.json

# ================================================================
#  Permintaan pemilik proyek — folder lokal/laporan, tidak ikut repo
# ================================================================
postman/
.postman/
test_report/
tabel_report/
tools/
catatan/
backup/

# Log hasil tools/start-log.bat (diagnosis "server mati sendiri")
logs/

# Artefak sesi Playwright MCP (log console/snapshot, khusus mesin ini)
.playwright-mcp/

# Fixture uji upload manual (ada file 20 MB) + dokumen laporan pribadi
test_files/
*.docx

# --- Berkas TA & aset laporan (bukan bagian program) ---
*.pdf
foto mockup/
alat pengujian/
docs/USULAN_*.md

# --- Keluaran graphify (dibangkitkan ulang: `graphify update .`) ---
graphify-out/

# --- Sampah sementara MS Word ---
~WRL*.tmp
